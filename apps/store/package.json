{
  "name": "store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node ./scripts/generate-seo-assets.mjs",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:staging": "node ./scripts/generate-seo-assets.mjs && vue-tsc -b && vite build --mode staging",
    "build:production": "node ./scripts/generate-seo-assets.mjs && vue-tsc -b && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "pinia": "^2.2.0",
    "@bap-shop/shared": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  }
}
